<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:simpleType name="PrixValeur">
        <xs:restriction base="xs:decimal">
            <xs:minExclusive value="0" />
            <xs:pattern value="[0-9]+\.[0-9]{2}" />
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="breakfast_menu">
        <xs:complexType>
            <xs:sequence>

                <xs:element name="food"
                    minOccurs="1"
                    maxOccurs="unbounded">

                    <xs:complexType>
                        <xs:sequence>

                            <xs:element name="price">
                                <xs:complexType>
                                    <xs:simpleContent>
                                        <xs:extension base="PrixValeur">
                                            <xs:attribute name="unit"
                                                type="xs:string"
                                                use="required" />
                                        </xs:extension>
                                    </xs:simpleContent>
                                </xs:complexType>
                            </xs:element>

                            <xs:element name="calories">
                                <xs:simpleType>
                                    <xs:restriction base="xs:integer">
                                        <xs:minInclusive value="100" />
                                        <xs:maxInclusive value="2000" />
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>

                        </xs:sequence>

                        <xs:attribute name="category" use="required">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:enumeration value="sweet" />
                                    <xs:enumeration value="salty" />
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>

                    </xs:complexType>
                </xs:element>

            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>